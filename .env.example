# TRADING NEWS AI - configurazione. Copia in .env e riempi SOLO cio' che usi.
# .env non va mai committato (e' in .gitignore). Nessun secret nel codice.

# --- Telegram (obbligatorio per pubblicare) ---
TELEGRAM_BOT_TOKEN=
TG_CHAT=-1003559029410

# --- AI (facoltativo) ---
# Se impostata, la classificazione/impatto/sentiment usano il modello.
# Se manca, si usa il motore a regole (funziona comunque, non inventa nulla).
# Endpoint OpenAI-compatibile: OpenAI, OpenRouter, Groq, locale...
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Frequenze (ore) ---
VISTA_DIGEST_EVERY_H=6
VISTA_NEWS_EVERY_H=2
VISTA_BRIEF_EVERY_H=24
VISTA_ALERT_PCT=5

# --- Referral (facoltativo, dichiarato nel footer) ---
VISTA_AFFILIATE=

# --- Database ---
VISTA_DB=./data/history.db

# --- Fonti che richiedono chiave (facoltative, non ancora attive) ---
NEWS_API_KEY=
MARKET_DATA_API_KEY=
ECONOMIC_CALENDAR_API_KEY=
